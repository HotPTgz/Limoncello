(footprint "SK6812MINI-E_MX_Reverse" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "SK6812MINI-E reverse-mount addressable RGB LED for MX switch LED slot. Place on the BACK side; body sits in the board cutout and shines up through the switch LED window. Pad geometry and pairing after marbastlib LED_MX_6028R / MX_SK6812MINI-E (CERN-OHL-P). Pin numbers follow the SK6812MINI-E datasheet: 1 VDD, 2 DOUT, 3 GND, 4 DIN.")
